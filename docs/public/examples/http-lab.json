{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "docs-lab",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "domain": [
          "demo.bbox.test"
        ],
        "action": "route",
        "outbound": "direct",
        "override_address": "127.0.0.1"
      }
    ]
  },
  "experimental": {
    "http_rewrite": {
      "enabled": true,
      "ports": [
        80
      ],
      "map_local": [
        {
          "name": "First local response",
          "pattern": "^http://demo\\.bbox\\.test(?::80)?/hello(?:\\?.*)?$",
          "status": 200,
          "headers": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-B-box",
              "value": "Map Local"
            }
          ],
          "data_type": "text",
          "data": "{\"ok\":true,\"message\":\"Hello from B-box\"}"
        }
      ]
    }
  }
}
